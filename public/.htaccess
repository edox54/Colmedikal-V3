<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www → non-www (HTTP and HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.colmedikal\.com [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ http://colmedikal.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.colmedikal\.com [NC]
  RewriteCond %{HTTPS} on
  RewriteRule ^ https://colmedikal.com%{REQUEST_URI} [R=301,L]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
