{
  "entities": {
    "Doctor": {
      "title": "Doctor",
      "description": "Un especialista médico prestador registrado en la red de Colmedikal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único del doctor" },
        "name": { "type": "string", "description": "Nombre completo" },
        "specialty": { "type": "string", "description": "Especialidad médica" },
        "city": { "type": "string", "description": "Ciudad de atención" },
        "phone": { "type": "string", "description": "Teléfono de contacto" },
        "email": { "type": "string", "description": "Correo electrónico" },
        "clinic": { "type": "string", "description": "Clínica o centro de atención" },
        "rating": { "type": "string", "description": "Calificación y status" },
        "availability": { "type": "string", "description": "Horarios de disponibilidad" },
        "education": { "type": "string", "description": "Educación y títulos" },
        "image": { "type": "string", "description": "URL de la imagen del avatar" },
        "cost": { "type": "number", "description": "Costo de la consulta" },
        "active": { "type": "boolean", "description": "Indica si el doctor está de alta" }
      },
      "required": ["id", "name", "specialty", "city", "clinic", "cost"]
    },
    "RefundItem": {
      "title": "RefundItem",
      "description": "Una solicitud de reembolso de gastos médicos tramitada por un asegurado.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de reembolso" },
        "familyMember": { "type": "string", "description": "Nombre del familiar beneficiario" },
        "specialty": { "type": "string", "description": "Especialidad médica de la consulta" },
        "amount": { "type": "number", "description": "Monto de la factura" },
        "refundDate": { "type": "string", "description": "Fecha del trámite (YYYY-MM-DD)" },
        "status": { "type": "string", "enum": ["Aprobado", "Procesando", "Reembolsado", "Rechazado"] },
        "invoiceNumber": { "type": "string", "description": "Número de factura SRI o comprobante" },
        "adminComment": { "type": "string", "description": "Comentarios de revisión de auditoría médica" },
        "fileName": { "type": "string", "description": "Nombre del archivo de comprobante adjunto" },
        "userEmail": { "type": "string", "description": "Correo del usuario solicitante" },
        "userPhone": { "type": "string", "description": "Teléfono de contacto del usuario" }
      },
      "required": ["id", "familyMember", "specialty", "amount", "refundDate", "status", "invoiceNumber"]
    },
    "AuthorizationItem": {
      "title": "AuthorizationItem",
      "description": "Una solicitud de orden de cobertura de procedimientos programados.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de autorización" },
        "patient": { "type": "string", "description": "Nombre del paciente beneficiario" },
        "procedure": { "type": "string", "description": "Procedimiento o examen solicitado" },
        "facility": { "type": "string", "description": "Centro médico o clínica provisoria" },
        "requestDate": { "type": "string", "description": "Fecha de solicitud (YYYY-MM-DD)" },
        "status": { "type": "string", "enum": ["Aprobado", "Pendiente", "Auditoría", "Rechazado"] },
        "adminComment": { "type": "string", "description": "Comentarios de aprobación o rechazo" },
        "fileName": { "type": "string", "description": "Nombre del archivo de orden médica" },
        "userEmail": { "type": "string", "description": "Correo del usuario" },
        "userPhone": { "type": "string", "description": "Teléfono del usuario" }
      },
      "required": ["id", "patient", "procedure", "facility", "requestDate", "status"]
    },
    "AppointmentItem": {
      "title": "AppointmentItem",
      "description": "Una agendación de cita médica formal con un especialista.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de la cita" },
        "doctorName": { "type": "string", "description": "Nombre del especialista" },
        "specialty": { "type": "string", "description": "Especialidad de la cita" },
        "patientName": { "type": "string", "description": "Nombre del paciente que se atenderá" },
        "patientId": { "type": "string", "description": "Cédula o ID de identidad del paciente" },
        "patientPhone": { "type": "string", "description": "Teléfono celular del paciente" },
        "aptDate": { "type": "string", "description": "Fecha de la cita" },
        "aptTime": { "type": "string", "description": "Hora de la cita" },
        "modality": { "type": "string", "enum": ["presencial", "telemedicina"] },
        "clinic": { "type": "string", "description": "Centro clínico" },
        "city": { "type": "string", "description": "Ciudad de atención" },
        "cost": { "type": "number", "description": "Costo estimado de consulta" },
        "status": { "type": "string", "enum": ["Pendiente", "Confirmada", "Cancelada", "Completada"] }
      },
      "required": ["id", "doctorName", "specialty", "patientName", "patientId", "patientPhone", "aptDate", "aptTime", "modality", "clinic", "city", "cost", "status"]
    },
    "QuoteState": {
      "title": "QuoteState",
      "description": "Estructura de la cotización calculada por el usuario.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["individual", "pareja", "familiar"] },
        "primaryAge": { "type": "number" },
        "partnerAge": { "type": "number" },
        "childrenCount": { "type": "number" },
        "childrenAges": { "type": "array" },
        "basePlanId": { "type": "string" }
      },
      "required": ["fullName", "email", "phone", "type", "primaryAge", "childrenCount", "basePlanId"]
    },
    "LeadQuote": {
      "title": "LeadQuote",
      "description": "Un prospecto comercial generado desde el cotizador de planes corporativos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID exclusivo del cliente potencial" },
        "timestamp": { "type": "string", "description": "Fecha y hora ISO de creación" },
        "quoteData": { "$ref": "#/entities/QuoteState" },
        "estimatedPrice": { "type": "number", "description": "Costo mensual estimado del plan" },
        "status": { "type": "string", "enum": ["Nuevo Plan", "Contactado", "Cierre Efectivo"] }
      },
      "required": ["id", "timestamp", "quoteData", "estimatedPrice", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Un usuario administrativo con privilegios para auditar, autorizar y gestionar prestadores.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Correo electrónico de Google del administrador" },
        "name": { "type": "string", "description": "Nombre completo o apodo corporativo" },
        "role": { "type": "string", "enum": ["Administrador", "Auditor Clínico"] },
        "addedAt": { "type": "string", "description": "Fecha y hora de asignación (ISO)" },
        "addedBy": { "type": "string", "description": "Email de quien otorgó el acceso" },
        "active": { "type": "boolean", "description": "Estado de activación" }
      },
      "required": ["email", "name", "role", "addedAt", "addedBy", "active"]
    }
  },
  "firestore": {
    "admins/{adminEmail}": {
      "schema": "AdminUser",
      "description": "Colección de accesos administrativo-corporativos para la red Colmedikal."
    },
    "doctors/{doctorId}": {
      "schema": "Doctor",
      "description": "Catálogo dinámico de especialistas médicos en el directorio live."
    },
    "refunds/{refundId}": {
      "schema": "RefundItem",
      "description": "Tramitación y seguimiento de reembolsos médicos."
    },
    "authorizations/{authorizationId}": {
      "schema": "AuthorizationItem",
      "description": "Trámites de solicitud de órdenes de cobertura médica."
    },
    "appointments/{appointmentId}": {
      "schema": "AppointmentItem",
      "description": "Citas médicas reservadas."
    },
    "leads/{leadId}": {
      "schema": "LeadQuote",
      "description": "Prospectos comerciales generados."
    }
  }
}
