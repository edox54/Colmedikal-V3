Options -MultiViews
RewriteEngine On

# Serve existing files and directories directly (JS, CSS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all page requests through PHP for per-route meta injection
RewriteRule ^ seo-render.php [L]
